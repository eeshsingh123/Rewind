# Copy to .env for local runs. .env is never committed.
META_API_KEY=
REWIND_DATA_ROOT=data
REWIND_MUSE_MODEL=muse-spark-1.3-contributor
# Perception and budget (T2). Every proxy frame is billed once per concept.
REWIND_TRACK_FPS=2.0
REWIND_WORKSPACE_DAILY_CAP_USD=5
REWIND_KILL_SWITCH_USD=120
# Signs media URLs; set it so links survive a restart. Base URL is the tunnel URL when public.
REWIND_MEDIA_SIGNING_KEY=
REWIND_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Sim bench (T1): Blender 4.5 for rendering scenarios.
REWIND_BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
