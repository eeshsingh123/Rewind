# Copy to .env for local runs. .env is never committed.
META_API_KEY=
REWIND_DATA_ROOT=data
REWIND_MUSE_MODEL=muse-spark-1.3-contributor
# Perception and budget. Every proxy frame is billed once per concept.
REWIND_TRACK_FPS=2.0
REWIND_WORKSPACE_DAILY_CAP_USD=5
REWIND_KILL_SWITCH_USD=120
# Signs media URLs; set it so links survive a restart. Base URL is the tunnel URL when public.
REWIND_MEDIA_SIGNING_KEY=
REWIND_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Chat. A channel whose token is unset is not started. Lists are comma-separated.
REWIND_DATABASE_URL=
REWIND_TELEGRAM_BOT_TOKEN=
REWIND_TELEGRAM_ALLOWED_USER_IDS=
REWIND_WHATSAPP_TOKEN=
REWIND_WHATSAPP_PHONE_NUMBER_ID=
REWIND_WHATSAPP_APP_ID=
REWIND_WHATSAPP_APP_SECRET=
REWIND_WHATSAPP_VERIFY_TOKEN=
REWIND_WHATSAPP_BUSINESS_ACCOUNT_ID=
REWIND_WHATSAPP_ALLOWED_NUMBERS=
REWIND_CONFIRM_ABOVE_USD=0.25
# Sim (frozen): Blender 4.5 for rendering scenarios.
REWIND_BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
